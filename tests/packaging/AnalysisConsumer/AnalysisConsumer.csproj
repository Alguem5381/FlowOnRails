<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageConsumerFramework Condition="'$(PackageConsumerFramework)' == ''">net10.0</PackageConsumerFramework>
    <TargetFramework>$(PackageConsumerFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlowOnRails.Analysis" Version="$(FlowOnRailsAnalysisVersion)" />
    <PackageReference Include="FlowOnRails" Version="$(FlowOnRailsVersion)" />
  </ItemGroup>
  <!-- Run the same packaged API inside the compiler shipped with SDK 11,
       while retaining Roslyn 5.0 as the package's minimum dependency. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <None Update="Input.cs.txt" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" ExcludeAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" Version="5.0.0" ExcludeAssets="all" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" />
  </ItemGroup>
</Project>
