<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>FlowOnRails.Analysis</PackageId>
    <Version>0.3.0</Version>
    <Authors>alguem5381</Authors>
    <Description>Roslyn API for querying FlowOnRails error flow in source methods and assembly summaries.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/Alguem5381/FlowOnRails</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <None Update="README.md" Pack="true" PackagePath="/" />
    <InternalsVisibleTo Include="FlowOnRails.Analyzers" />
    <InternalsVisibleTo Include="FlowOnRails.CodeFixes" />
  </ItemGroup>
</Project>
