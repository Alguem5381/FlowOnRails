<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <FlowOnRailsEnableFlowAnalysis>true</FlowOnRailsEnableFlowAnalysis>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/FlowOnRails.Analysis/FlowOnRails.Analysis.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/FlowOnRails.CodeFixes/FlowOnRails.CodeFixes.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <CompilerVisibleProperty Include="FlowOnRailsEnableFlowAnalysis" />
    <ProjectReference Include="../../src/FlowOnRails/FlowOnRails.csproj" />
    <ProjectReference Include="../../src/FlowOnRails.Analyzers/FlowOnRails.Analyzers.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
