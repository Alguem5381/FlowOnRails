<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <PackageConsumerFramework Condition="'$(PackageConsumerFramework)' == ''">net10.0</PackageConsumerFramework>
    <TargetFramework>$(PackageConsumerFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="FlowOnRails.AspNetCore" Version="$(FlowOnRailsAspNetCoreVersion)" />
  </ItemGroup>
</Project>
